    {
        "id": "ee4127c51831bbe2",
        "type": "function",
        "z": "778d3c8abff0245e",
        "name": "Add Device to list of seen",
        "func": "var list = global.get(\"DeviceList\");\n\nif(list == null){\n    list = {};\n}\n\nif (msg.payload.mac != null){\n    //Add a timestamp for last seen?\n    list[msg.payload.mac] = msg.payload;\n    global.set(\"DeviceList\", list);\n}else{\n    //Note error in second output\n    msg.error = \"Error mall formed 'mac' field\";\n    return [null,msg];\n}\n\nreturn [msg,null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
