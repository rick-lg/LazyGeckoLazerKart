    {
        "id": "faf5eb85c6fb793c",
        "type": "function",
        "z": "dbd7a3baf3d06faf",
        "name": "Parse Bin Files",
        "func": "//Update teh Global Defiiniton of the OTAs available.\n/*\npayload: \n\n\"7.03.2025-d2.0-DEMO_BLOWER.bin\n7.03.2025-d2.0-DEMO_BUBBLE.bin\n7.03.2025-d2.0-DEMO_EAGLE.bin\n7.03.2025-d2.0-DEMO_FOG.bin\n7.03.2025-d2.0-DEMO_GOKART.bin\n7.03.2025-d2.0-DEMO_WATER.bin\"\n*/\n\n// Split by newlines\nlet lines = msg.payload.trim().split('\\n');\n\nlet results = {};\n\nlines.forEach(filename => {\n  let match = filename.match(/-d([\\d.]+)-DEMO_([A-Z]+)\\.bin$/);\n  if (match) {\n    let version = parseFloat(match[1]);\n    let name = match[2];\n    let obj = {};\n    obj[\"type\"] = name;\n    obj[\"version\"] = version;\n    obj[\"filename\"] = filename;\n    results[name] = obj;\n  }\n});\n\nmsg.payload = results;\nglobal.set(\"OTAList\", results);\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 780,
        "y": 440,
        "wires": [
            [
                "72ee30fd02420e01"
            ]
        ]
    },
