    {
        "id": "8fccaa72286265f2",
        "type": "function",
        "z": "dbd7a3baf3d06faf",
        "name": "Queue for OTA?",
        "func": "//Look at their firmware version and device type \n//and determine if they need an update\n\nvar otas = global.get(\"OTAList\");\n\n\n\nvar dev_id = msg.topic.split(\"/\")[1];\n//\"!7.03.2025-d2.0-DEMO\"\n//d2.0 is the important part\nvar firmware = msg.payload.firmware; \nvar dev_type = String(msg.payload.type);\n\nvar version = 0.0;\n\nif (firmware != null){\n    let match = firmware.match(/^!?7\\.\\d{2}\\.2025-d([\\d.]+)-DEMO(?:_([A-Z]+))?(?:\\.bin)?$/);\n    if (match) {\n        version = parseFloat(match[1]);\n    }\n\n    msg.payload.version = version;\n    msg.payload.ota = otas[dev_type].version;\n\n    if (version < otas[dev_type].version){\n        //Need to OTA        \n        msg.payload.otaurl = \"http://192.168.69.1:1880/ota/\"+otas[dev_type].filename;   \n\n        msg.topic = \"device/\"+dev_id+\"/ota\";\n    }\n}\n\n//Check the name of the correct device bin file\n\n//Is it newer then what the device has?\n//Send them the update? curl it to them?\n\n\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 240,
        "wires": [
            [
                "640c6d71fd13cccf",
                "fad111903adef570"
            ]
        ]
    },
